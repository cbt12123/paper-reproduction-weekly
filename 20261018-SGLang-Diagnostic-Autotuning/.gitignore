# Reproducible build output and local inspection files
/tmp/
/output/*.zip
__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store
Thumbs.db

# Local credentials and environment configuration
.env
.env.*
!.env.example
*.pem
*.key

# Large experiment inputs and raw traces stay outside Git
/experiments/raw/
/experiments/models/
/experiments/cache/

# LaTeX compilation intermediates (PDF reading copies are tracked)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.xdv
